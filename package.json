{
  "name": "linkly",
  "version": "1.0.0",
  "description": "A URL shortener with analytics",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint . --config eslint.local.config.js",
    "lint:fix": "eslint . --config eslint.local.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node scripts/db-setup.js"
  },
  "keywords": [],
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
