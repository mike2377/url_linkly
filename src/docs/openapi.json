{
  "openapi": "3.1.0",
  "info": {
    "title": "Linkly API",
    "version": "1.0.0",
    "description": "A URL shortener with analytics. Turn long URLs into short codes, redirect visitors, and track clicks with an atomic counter"
  },
  "server": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Links",
      "description": "Create, read, delete short links"
    },
    {
      "name": "Redirects",
      "description": "Redirect to target URL and record click"
    },
    {
      "name": "Analytics",
      "description": "Click log and CSV export"
    },
    {
      "name": "Health",
      "description": "Live and database check"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Live check",
        "responses": {
          "200": {
            "description": "App and database OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable"
          }
        }
      }
    },
    "/links": {
      "post": {
        "tags": [
          "Links"
        ],
        "summary": "Create a short link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLinkRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Link created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "description": "Rate limit exceedes (100/min per IP)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until next request allowed"
              }
            }
          }
        }
      }
    },
    "/links/{code}": {
      "get": {
        "tags": [
          "Links"
        ],
        "summary": "Get link metadata (is not record click)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          }
        ],
        "responses": {
          "200": {
            "description": "Link metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkMetadata"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Links"
        ],
        "summary": "Delete a link and its clicks (cascade delete)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/links/{code}/clicks": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Paginated click log for a link",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursro: last click ID from previous page (exclusive first page)",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (max 100, default 20)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Clicks page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClickPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/clicks/{code}/clicks.csv": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Stream CSV export of the clicks log",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV stream",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/{code}": {
      "get": {
        "tags": [
          "Redirect"
        ],
        "summary": "Redirect to target URL and record click",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          }
        ],
        "response": {
          "302": {
            "description": "Found, redirect to target_rul",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "url"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "description": "Gone, link expired"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Code": {
        "name": "code",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{3,16}$"
        }
      }
    },
    "schemas": {
      "CreateLinkRequest": {
        "type": "object",
        "required": [
          "target_url"
        ],
        "properties": {
          "target_url": {
            "type": "string",
            "format": "url",
            "description": " Using http or https"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{3,16}$",
            "description": "Optional, auto if missing"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional ISO 8601 timestamp, after tis the link return 410"
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "target_url": {
            "type": "string",
            "format": "url"
          },
          "short_url": {
            "type": "string",
            "format": "url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "click_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "LinkMetadata": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "target_url": {
            "type": "string",
            "format": "url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "click_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Click": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "clicked_at": {
            "type": "string",
            "format": "date-time"
          },
          "referrer": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ClickPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Click"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Pass as ?after= on next request (Null for no more pages)"
          }
        }
      },
      "Error": {
        "type": "object",
        "propeerties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Code already taken",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid input (Zod issues)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}